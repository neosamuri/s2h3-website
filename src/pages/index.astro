---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="S2H3 | Sloppy Saturday Hash House Harriers">
  <section class="mx-auto flex max-w-6xl flex-col gap-10 px-6 py-10">
    <section class="grid items-center gap-8 border-b border-orange-400/20 pb-10 md:grid-cols-[1fr_320px]">
      <div class="flex flex-col gap-4">
        <p class="text-sm font-bold uppercase tracking-[0.3em] text-orange-300">
          S2H3
        </p>

        <h1 class="text-4xl font-black tracking-tight sm:text-6xl">
          Sloppy Saturday Hash House Harriers
        </h1>

        <p class="max-w-2xl text-lg text-stone-300">
          A drinking club with a running problem. Trails, beer, shiggy, songs,
          and questionable decisions on Saturdays.
        </p>

        <div class="flex flex-wrap gap-3 pt-2">
          <a
            href="/hareline"
            class="rounded-xl bg-orange-500 px-5 py-3 font-black text-stone-950 hover:bg-orange-400"
          >
            View Hare Line
          </a>

          <a
            href="/about"
            class="rounded-xl border border-stone-700 px-5 py-3 font-bold hover:bg-stone-900"
          >
            What is S2H3?
          </a>
        </div>
      </div>

      <div class="mx-auto w-full max-w-[280px] md:max-w-[320px]">
        <img
          src="/images/s2h3-logo.png"
          alt="S2H3 logo"
          class="w-full rounded-full shadow-2xl shadow-orange-950/30"
        />
      </div>
    </section>

    <section id="next-hash">
      <div class="rounded-3xl border border-orange-400/30 bg-stone-900 p-6">
        <p class="text-sm font-bold uppercase tracking-[0.25em] text-orange-300">
          Loading next hash...
        </p>
      </div>
    </section>

    <section class="grid gap-4 md:grid-cols-3">
      <div class="rounded-2xl bg-stone-900 p-5">
        <h3 class="text-xl font-black">What is hashing?</h3>
        <p class="mt-2 text-stone-400">
          Part trail run, part scavenger hunt, part social club. Follow flour,
          find beer, sing badly.
        </p>
      </div>

      <div class="rounded-2xl bg-stone-900 p-5">
        <h3 class="text-xl font-black">All paces welcome</h3>
        <p class="mt-2 text-stone-400">
          Runners, walkers, stumblers, and professional shortcutters are all
          welcome.
        </p>
      </div>

      <div class="rounded-2xl bg-stone-900 p-5">
        <h3 class="text-xl font-black">Saturday trails</h3>
        <p class="mt-2 text-stone-400">
          Sloppy by name, sloppy by nature. Watch this space for the next hare
          line.
        </p>
      </div>
    </section>
  </section>

  <script type="module">
    import Papa from "https://cdn.jsdelivr.net/npm/papaparse@5.4.1/+esm";

    const SHEET_URL =
      "https://docs.google.com/spreadsheets/d/e/2PACX-1vSeOtc-wh6amahFVCZqn7oXXAwNgM_B9rwRzH8kzVxH2lATSnokc6d4I6tW_wpW4WDjRqaR_r4iksX5/pub?gid=0&single=true&output=csv";

    const clean = (value) => value || "";

    const formatDate = (date) => {
      if (!date) return "";

      const parsedDate = new Date(`${date}T12:00:00`);

      if (isNaN(parsedDate.getTime())) {
        return date;
      }

      return parsedDate.toLocaleDateString("en-CA", {
        weekday: "long",
        year: "numeric",
        month: "long",
        day: "numeric",
      });
    };

    const formatTime = (time) => {
      if (!time) return "";

      const parsedTime = new Date(`January 1, 2000 ${time}`);

      if (isNaN(parsedTime.getTime())) {
        return time;
      }

      return parsedTime.toLocaleTimeString("en-CA", {
        hour: "numeric",
        minute: "2-digit",
        hour12: true,
      });
    };

    async function getEvents() {
      const response = await fetch(SHEET_URL);
      const csv = await response.text();

      const parsed = Papa.parse(csv, {
        header: true,
        skipEmptyLines: true,
      });

      return parsed.data
        .filter((event) => clean(event.published).trim().toUpperCase() === "TRUE")
        .sort((a, b) => clean(a.date).localeCompare(clean(b.date)));
    }

    function renderNextHash(event) {
      const container = document.querySelector("#next-hash");

      if (!event) {
        container.innerHTML = `
          <section class="rounded-3xl border border-orange-400/30 bg-stone-900 p-6">
            <p class="text-sm font-bold uppercase tracking-[0.25em] text-orange-300">
              Next Hash
            </p>
            <h2 class="mt-3 text-3xl font-black">No published trails yet</h2>
            <p class="mt-3 text-stone-300">Check back soon.</p>
          </section>
        `;
        return;
      }

      container.innerHTML = `
        <section class="rounded-3xl border border-orange-400/30 bg-stone-900 p-6 shadow-2xl shadow-orange-950/20">
          <p class="mb-3 text-sm font-bold uppercase tracking-[0.25em] text-orange-300">
            Next Hash
          </p>

          <div class="grid gap-8 md:grid-cols-[1.2fr_0.8fr]">
            <div>
              <h2 class="text-3xl font-black sm:text-5xl">
                Trail #${clean(event.trailNumber)}: ${clean(event.title)}
              </h2>
              <p class="mt-4 text-xl text-stone-300">
                ${clean(event.description)}
              </p>
            </div>

            <div class="rounded-2xl bg-stone-950 p-5">
              <dl class="space-y-4">
                <div>
                  <dt class="text-sm text-stone-500">Date</dt>
                  <dd class="font-bold">${formatDate(event.date)}</dd>
                </div>

                <div>
                  <dt class="text-sm text-stone-500">Time</dt>
                  <dd class="font-bold">${formatTime(event.time)}</dd>
                </div>

                <div>
                  <dt class="text-sm text-stone-500">Location</dt>
                  <dd class="font-bold">${clean(event.locationName)}</dd>
                  <dd class="text-stone-400">${clean(event.address)}</dd>
                </div>

                <div>
                  <dt class="text-sm text-stone-500">Hares</dt>
                  <dd class="font-bold">${clean(event.hares)}</dd>
                </div>

                <div>
                  <dt class="text-sm text-stone-500">Hash Cash</dt>
                  <dd class="font-bold">$${clean(event.hashCash)}</dd>
                </div>
              </dl>

              <div class="mt-6 grid gap-3">
                <a
                  href="${clean(event.mapUrl) || "#"}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-xl bg-orange-500 px-5 py-3 text-center font-black text-stone-950 hover:bg-orange-400"
                >
                  Get Directions
                </a>

                <a
                  href="${clean(event.paypalUrl) || "#"}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-xl border border-stone-700 px-5 py-3 text-center font-bold hover:bg-stone-800"
                >
                  Pay Hash Cash
                </a>
              </div>
            </div>
          </div>
        </section>
      `;
    }

    getEvents()
      .then((events) => renderNextHash(events[0]))
      .catch(() => {
        document.querySelector("#next-hash").innerHTML = `
          <section class="rounded-3xl border border-orange-400/30 bg-stone-900 p-6">
            <h2 class="text-2xl font-black">Could not load Hare Line</h2>
            <p class="mt-3 text-stone-300">Try refreshing the page.</p>
          </section>
        `;
      });
  </script>
</BaseLayout>