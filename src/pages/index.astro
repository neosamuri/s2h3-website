---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEvents } from "../data/googleSheetEvents";

const events = await getEvents();
const nextHash = events[0];

const formatDate = (date: string) =>
  new Date(`${date}T12:00:00`).toLocaleDateString("en-CA", {
    weekday: "long",
    year: "numeric",
    month: "long",
    day: "numeric",
  });

const formatTime = (time: string) =>
  new Date(`2000-01-01T${time}`).toLocaleTimeString("en-CA", {
    hour: "numeric",
    minute: "2-digit",
    hour12: true,
  });
---

<BaseLayout title="S2H3 | Sloppy Saturday Hash House Harriers">
  <section class="mx-auto flex max-w-5xl flex-col gap-10 px-6 py-10">
    <section class="flex flex-col gap-3 border-b border-orange-400/20 pb-8">
      <p class="text-sm font-bold uppercase tracking-[0.3em] text-orange-300">
        S2H3
      </p>
      <h1 class="text-4xl font-black tracking-tight sm:text-6xl">
        Sloppy Saturday Hash House Harriers
      </h1>
      <p class="max-w-2xl text-lg text-stone-300">
        A drinking club with a running problem. Trails, beer, shiggy, songs,
        and questionable decisions on Saturdays.
      </p>
    </section>

    {nextHash ? (
      <section class="rounded-3xl border border-orange-400/30 bg-stone-900 p-6 shadow-2xl shadow-orange-950/20">
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.25em] text-orange-300">
          Next Hash
        </p>

        <div class="grid gap-8 md:grid-cols-[1.2fr_0.8fr]">
          <div>
            <h2 class="text-3xl font-black sm:text-5xl">
              Trail #{nextHash.trailNumber}: {nextHash.title}
            </h2>
            <p class="mt-4 text-xl text-stone-300">{nextHash.description}</p>
          </div>

          <div class="rounded-2xl bg-stone-950 p-5">
            <dl class="space-y-4">
              <div>
                <dt class="text-sm text-stone-500">Date</dt>
                <dd class="font-bold">{formatDate(nextHash.date)}</dd>
              </div>

              <div>
                <dt class="text-sm text-stone-500">Time</dt>
                <dd class="font-bold">{formatTime(nextHash.time)}</dd>
              </div>

              <div>
                <dt class="text-sm text-stone-500">Location</dt>
                <dd class="font-bold">{nextHash.locationName}</dd>
                <dd class="text-stone-400">{nextHash.address}</dd>
              </div>

              <div>
                <dt class="text-sm text-stone-500">Hares</dt>
                <dd class="font-bold">{nextHash.hares}</dd>
              </div>

              <div>
                <dt class="text-sm text-stone-500">Hash Cash</dt>
                <dd class="font-bold">${nextHash.hashCash}</dd>
              </div>
            </dl>

            <div class="mt-6 grid gap-3">
              <a href={nextHash.mapUrl || "#"} target="_blank" rel="noopener noreferrer" class="rounded-xl bg-orange-500 px-5 py-3 text-center font-black text-stone-950 hover:bg-orange-400">
                Get Directions
              </a>

              <a href={nextHash.paypalUrl || "#"} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-stone-700 px-5 py-3 text-center font-bold hover:bg-stone-800">
                Pay Hash Cash
              </a>
            </div>
          </div>
        </div>
      </section>
    ) : (
      <section class="rounded-3xl border border-orange-400/30 bg-stone-900 p-6">
        <p class="text-sm font-bold uppercase tracking-[0.25em] text-orange-300">
          Next Hash
        </p>
        <h2 class="mt-3 text-3xl font-black">No published trails yet</h2>
        <p class="mt-3 text-stone-300">
          Add a row to the S2H3 Hare Line sheet with published set to TRUE.
        </p>
      </section>
    )}
  </section>
</BaseLayout>