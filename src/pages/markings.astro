---
import BaseLayout from "../layouts/BaseLayout.astro";

const markings = [
  { mark: "HH →", name: "True Trail", note: "You are on true trail." },
  { mark: "•", name: "On-One", note: "First dot after a check." },
  { mark: "••", name: "On-Two", note: "Second dot." },
  { mark: "•••", name: "On-On", note: "Third dot confirms trail." },
  { mark: "⊙", name: "Check", note: "Trail starts again from here. Find the next mark." },
  { mark: "⊙ ⊙", name: "Boob Check", note: "Special check. Rules explained by the hare." },
  { mark: "⊙⊙↧", name: "Dick Check", note: "Special check. Rules explained by the hare." },
  { mark: "••• / =", name: "False", note: "Bad trail. Go back to the last check." },
  { mark: "YBF", name: "You’ve Been Fucked", note: "Definitely wrong. Return to trail." },
  { mark: "↶", name: "Check Back", note: "Go back one mark/check." },
  { mark: "↶ 69", name: "Check Back 69", note: "Go back 69 dots or as directed." },
  { mark: "↗ ↖", name: "Ambler / Dasher Split", note: "Walkers and runners split." },
  { mark: "⋀", name: "Merge", note: "Trails rejoin." },
  { mark: "AS", name: "All Song", note: "All song candidates regroup to sing." },
  { mark: "SC", name: "Song Check", note: "At least two people gather to sing." },
  { mark: "🎣", name: "Fish Hook", note: "Previous two people or group return back." },
  { mark: "BC", name: "Beer Check", note: "Mid-trail beer stop." },
  { mark: "BN", name: "Beer Near", note: "Beer is close." },
  { mark: "ON-IN", name: "Finish", note: "Trail is ending." },
  { mark: "TF / FE", name: "Turkey / Eagle Split", note: "Short route / long route split." },
];

---

<BaseLayout title="Trail Markings | S2H3">
  <section class="mx-auto max-w-6xl px-6 py-10">
    <div class="grid gap-8 border-b border-orange-400/20 pb-8 md:grid-cols-[1fr_220px] md:items-center">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.3em] text-orange-300">
          S2H3 Trail Guide
        </p>

        <h1 class="mt-3 text-4xl font-black sm:text-5xl">Trail Markings</h1>

        <p class="mt-4 max-w-2xl text-stone-300">
          Follow flour, chalk, arrows, dots, lies, bad decisions, and whoever
          looks like they know where they’re going.
        </p>
      </div>

      <img
        src="/images/s2h3-logo-512.png"
        alt="S2H3 logo"
        class="mx-auto w-40 rounded-full shadow-2xl shadow-orange-950/30 md:w-52"
      />
    </div>

    <div class="mt-8 rounded-2xl border border-orange-400/20 bg-stone-900 p-5">
      <h2 class="text-2xl font-black text-orange-300">How trail works</h2>
      <p class="mt-3 text-stone-300">
        Marks are usually laid in flour, chalk, or whatever the hares had left
        in the car. Three dots generally means you are on true trail. Checks
        mean stop searching in one direction and start making questionable
        choices in all directions.
      </p>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {markings.map((item) => (
        <article class="rounded-2xl border border-orange-400/20 bg-stone-900 p-5">
          <div class="flex min-h-24 items-center justify-center rounded-xl bg-stone-950 p-4">
            <span class="text-center text-4xl font-black text-orange-300">
              {item.mark}
            </span>
          </div>

          <h2 class="mt-4 text-xl font-black">{item.name}</h2>
          <p class="mt-2 text-sm leading-relaxed text-stone-400">
            {item.note}
          </p>
        </article>
      ))}
    </div>

    <div class="mt-8 rounded-2xl border border-orange-400/20 bg-stone-900 p-5">
      <h2 class="text-2xl font-black text-orange-300">Important notes</h2>

      <ul class="mt-4 grid gap-3 text-stone-300">
        <li>
          <strong>Don’t assume.</strong> Local traditions vary. Listen to the
          hare before trail.
        </li>
        <li>
          <strong>Regroup when needed.</strong> Song checks, beer checks, and
          special checks are there to bring the pack together.
        </li>
        <li>
          <strong>Know your limits.</strong> Shortcutting is a proud hashing
          tradition.
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>